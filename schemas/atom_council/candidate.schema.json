{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arac.local/schemas/atom_council/candidate.schema.json",
  "title": "Atom Council Candidate (redacted)",
  "description": "Entrée du Conseil des Atomes : candidate redacted, jamais un raw transcript, jamais un secret. Bornes anti-transcript (body <= 2000 chars).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "proposal_id",
    "title_redacted",
    "body_redacted",
    "kind_suggested",
    "scope_suggested",
    "provenance_redacted",
    "risk_flags",
    "confidence"
  ],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 128 },
    "proposal_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 128 },
    "title_redacted": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body_redacted": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "kind_suggested": { "type": "string", "minLength": 1, "maxLength": 64 },
    "scope_suggested": { "type": "string", "minLength": 1, "maxLength": 64 },
    "provenance_redacted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file_id", "source_hash_redacted", "pipeline"],
      "properties": {
        "source_file_id": { "type": ["string", "null"], "maxLength": 64 },
        "source_hash_redacted": { "type": "string", "maxLength": 16 },
        "pipeline": { "type": "string", "maxLength": 200 }
      }
    },
    "risk_flags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 80 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
